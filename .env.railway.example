# Railway deployment notes for 3x-ui
#
# Railway injects a dynamic PORT value. The container entrypoint maps that to
# XUI_PORT automatically, so you usually do not need to set XUI_PORT manually.
#
# Recommended values when using the PostgreSQL add-on:
XUI_DB_TYPE=postgres
XUI_DB_DSN=postgres://postgres:YOUR_PASSWORD@YOUR_HOST:5432/railway?sslmode=require
XUI_ENABLE_FAIL2BAN=false
XUI_DEBUG=false
XUI_LOG_LEVEL=info
XUI_INIT_WEB_BASE_PATH=/

# Optional overrides:
# XUI_PORT=2053
# XUI_MAIN_FOLDER=/app
# XUI_BIN_FOLDER=/app/bin
# XUI_LOG_FOLDER=/var/log/x-ui

# Railway will set PORT automatically; do not change it unless the app is
# explicitly bound to a different port.
